# ============================================================
# DOCUMIND AI - ENVIRONMENT TEMPLATE
# ============================================================

# Application
APP_NAME=DocuMind AI
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=false

# Database
DATABASE_URL=sqlite:///./data/documind.db

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documind_bge_m3
QDRANT_UPSERT_BATCH_SIZE=64

# Embedding
BGE_M3_MODEL=BAAI/bge-m3

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
RERANKER_MAX_LENGTH=512

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# RAG
RETRIEVAL_LIMIT=12
FINAL_TOP_K=8
SOURCE_SCORE_MARGIN=1.0
MAX_DISPLAY_SOURCES=5

# Chunking
CHUNK_SIZE=700
CHUNK_OVERLAP=200

# Storage
UPLOAD_DIR=data/uploads

# CORS
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000